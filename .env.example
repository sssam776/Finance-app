# First admin account, created by db/seed.ts. Leave the password blank and the
# seed generates a random one and prints it once. Re-seeding never overwrites
# an existing account's password.
ADMIN_EMAIL=admin@ramwall.local
ADMIN_INITIAL_PASSWORD=

# Local SQLite file (quick-version stand-in for Cloudflare D1)
SQLITE_DB_PATH=./data/ramwall.db

# Local raw-file store (quick-version stand-in for Cloudflare R2)
RAW_FILE_STORE_PATH=./data/raw-files

# Spec 9.6 production compliance gate. Only meaningful once two or more
# production Xero apps are enabled; the database approval records must pass
# regardless of this flag.
XERO_MULTI_APP_ENABLED=false

# Xero OAuth callback — must exactly match the redirect URI registered
# against the Xero Developer Portal app.
XERO_REDIRECT_URI=http://localhost:3000/api/xero/oauth/callback

# Credentials for the seeded Xero apps (db/seed.ts). Create a Web App OAuth
# registration at https://developer.xero.com/app/manage for each, with the
# read_core_v2 scopes (see lib/xero/scopeProfiles.ts) and the redirect URI
# above. The redirect URI must match character for character or authorisation
# fails before a consent screen is ever shown.
#
# Each registration is a separate app on Xero with its own credentials, and
# each carries its own five-connection Starter limit. There is no automatic
# spillover between them: which app an organisation connects through is chosen
# in the interface (spec 7.6.2).
XERO_RAMWALL_READ_CORE_DEV_CLIENT_ID=
XERO_RAMWALL_READ_CORE_DEV_CLIENT_SECRET=

XERO_RAMWALL_READ_CORE_DEV_2_CLIENT_ID=
XERO_RAMWALL_READ_CORE_DEV_2_CLIENT_SECRET=

# 32-byte key, base64-encoded, used to encrypt stored Xero token sets
# (AES-256-GCM). Generate with: openssl rand -base64 32
XERO_TOKEN_ENCRYPTION_KEY_V1=

# --- Composio Connect (client's Xero organisations) --------------------------
# The client's Xero organisations are authorised into Composio rather than into
# this app, so no Xero client ID, secret or token ever reaches us for them.
# Composio injects the credentials on its side.
#
# This is the CONSUMER key (ck_...) from Composio -> Connect -> Sessions & API
# Key, sent on the x-consumer-api-key header. It is NOT the project API key
# (ak_...) used by backend.composio.dev with x-api-key; the two are different
# key types on different endpoints, and using one for the other answers
# "Invalid API key" rather than saying the endpoint is wrong.
#
# Set it with: npx tsx scripts/set-composio-key.ts
# COMPOSIO_CONSUMER_KEY=
