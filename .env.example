# Local SQLite file (quick-version stand-in for Cloudflare D1)
SQLITE_DB_PATH=./data/ramwall.db

# Local raw-file store (quick-version stand-in for Cloudflare R2)
RAW_FILE_STORE_PATH=./data/raw-files

# Xero OAuth callback — must exactly match the redirect URI registered
# against the Xero Developer Portal app.
XERO_REDIRECT_URI=http://localhost:3000/api/xero/oauth/callback

# Credentials for the seeded "ramwall_read_core_dev" Xero app (db/seed.ts).
# Create a Web App OAuth registration at https://developer.xero.com/app/manage
# with the read_core_v1 scopes (see lib/xero/scopeProfiles.ts) and the
# redirect URI above.
XERO_RAMWALL_READ_CORE_DEV_CLIENT_ID=
XERO_RAMWALL_READ_CORE_DEV_CLIENT_SECRET=

# 32-byte key, base64-encoded, used to encrypt stored Xero token sets
# (AES-256-GCM). Generate with: openssl rand -base64 32
XERO_TOKEN_ENCRYPTION_KEY_V1=
