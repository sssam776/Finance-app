# Copy to deploy/.env on the server and fill in. Never commit the filled copy.
#
# SITE_ADDRESS is the hostname Caddy will request a certificate for. It must be
# a hostname, not a bare IP — Let's Encrypt does not issue certificates for IP
# addresses. With no domain of your own, sslip.io resolves one to any IP for
# free: 203.0.113.10.sslip.io points at 203.0.113.10.
SITE_ADDRESS=

# First administrator, created once by db/seed.ts.
ADMIN_EMAIL=admin@ramwall.local

# 32 bytes, base64. Encrypts stored Xero token sets at rest.
# Generate a NEW one for this deployment — never reuse a development key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it means every Xero organisation must reconnect.
XERO_TOKEN_ENCRYPTION_KEY_V1=

# From developer.xero.com. The redirect URI is derived from SITE_ADDRESS and
# must be registered on each app, character for character.
XERO_RAMWALL_READ_CORE_DEV_CLIENT_ID=
XERO_RAMWALL_READ_CORE_DEV_CLIENT_SECRET=

# Second registration. Leave blank if only one app is in use.
XERO_MULTI_APP_ENABLED=false
XERO_RAMWALL_READ_CORE_DEV_2_CLIENT_ID=
XERO_RAMWALL_READ_CORE_DEV_2_CLIENT_SECRET=
